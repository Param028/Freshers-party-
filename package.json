  "version": "1.0.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server.js",
    "build": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.mkdirSync('dist');for(const f of ['index.html','admin.html','styles.css','script.js','contact-phone.js','logo.svg'])fs.copyFileSync(f,'dist/'+f);fs.copyFileSync('public/manus-routes.json','dist/manus-routes.json')\""
  }
}
